{
  "expo": {
    "name": "DTLAHappening",
    "slug": "dtlahappening",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "dtlahappening",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0a0a0c",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dtlahappening.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Scanning ticket QR codes at venue doors.",
        "NSLocationWhenInUseUsageDescription": "Showing events near you on the map, and where you are in relation to them."
      }
    },
    "android": {
      "package": "com.dtlahappening.app",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.dtlahappening.app",
          "enableGooglePay": false
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
