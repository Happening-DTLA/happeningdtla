{
  "expo": {
    "name": "DTLAHappening",
    "slug": "dtlahappening",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/70169062-3300-4455-b53c-3327511ab869",
      "fallbackToCacheTimeout": 3000
    },
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "dtlahappening",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0a0a0c",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dtlahappening.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Scanning ticket QR codes at venue doors.",
        "NSLocationWhenInUseUsageDescription": "Showing events near you on the map, and where you are in relation to them."
      }
    },
    "android": {
      "package": "com.dtlahappening.app",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.dtlahappening.app",
          "enableGooglePay": false
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-font",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "70169062-3300-4455-b53c-3327511ab869"
      }
    },
    "owner": "logan_tierno"
  }
}
