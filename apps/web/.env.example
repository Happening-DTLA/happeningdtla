# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# For local development you do NOT need to set DATABASE_URL by hand:
# `npm run db:start` boots a local Postgres and writes the URL in for you.

# ---- Database -------------------------------------------------------------
DATABASE_URL=
SHADOW_DATABASE_URL=
# PEM of the database provider's root CA, when it uses a private one.
# Supabase does: without this, connections fail with "self-signed certificate
# in certificate chain". Download it from Project Settings -> Database -> SSL.
# Public certificate, not a secret — but it expires, so it lives in config.
DATABASE_CA_CERT=

# ---- Auth (Clerk) ---------------------------------------------------------
# https://dashboard.clerk.com — create ONE app, share the dev keys between us.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- Payments (Stripe) ----------------------------------------------------
# https://dashboard.stripe.com — use TEST keys (sk_test_… / pk_test_…) until
# we are genuinely ready to take money. Test and live keys are not
# interchangeable and a live key in a dev .env is how real cards get charged
# by accident.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:3100/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=

# ---- Email ----------------------------------------------------------------
# Optional. With no key, confirmation emails are logged to the server console
# (link included) rather than sent, so local development needs no signup.
# Free tier at resend.com.
RESEND_API_KEY=
# Requires a verified sending domain. Unset falls back to Resend's shared
# onboarding address, which only delivers to the account owner.
EMAIL_FROM=
# Recipient for artist-submission notifications.
SUBMISSIONS_EMAIL=info@dtlaartnight.com

# ---- Artist image storage -------------------------------------------------
# Server-only key used to mint short-lived Supabase Storage upload URLs.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Error reporting (Sentry) ---------------------------------------------
# Runtime DSN. Keep PII, replay, screenshots and tracing disabled in code.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-time source-map upload. Use a narrowly scoped organization token.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ---- Door / admin ---------------------------------------------------------
# PLACEHOLDER until real organizer accounts exist. Gates creating door pairing
# codes. Replace with Clerk + OrganizerRole before any venue partner uses this.
ADMIN_API_SECRET=

# ---- Abuse control ----------------------------------------------------------
# All optional; the defaults in src/lib/rate-limit.ts are sensible. Limits are
# counted per 10-minute or 1-hour window.
#
# Per buyer (address + email). Tight — nobody legitimately starts five
# checkouts in ten minutes.
CHECKOUT_RATE_PER_BUYER_10MIN=
CHECKOUT_RATE_PER_BUYER_HOUR=
# Per address, everyone behind it. A venue's wifi is ONE address, so at a busy
# door dozens of real buyers share it. Raise this before a big night rather
# than finding out at the door.
CHECKOUT_RATE_PER_IP_10MIN=
# Guesses at a door pairing code.
DOOR_PAIR_RATE_PER_10MIN=
# Development only, and refused in production. Set to "true" when running the
# suites repeatedly so a limit doesn't fail a test for an unrelated reason.
RATE_LIMIT_DISABLED=

# ---- Features ---------------------------------------------------------------
# Ticketing (checkout, wallet, door scanner) is hidden unless this is "on".
# The code is always compiled; this only controls whether it is shown.
NEXT_PUBLIC_TICKETING=

# ---- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3100

# ---- Platform admin -------------------------------------------------------
# Who can see /admin — the artist submission review queue. Comma-separated
# email addresses, matched against the signed-in Clerk account's User.email.
# ArtistSubmission has no organizer or venue, so there is no per-venue scope
# to filter it by; without this list nobody sees it, which is the safe default
# because those rows hold artists' home addresses.
ADMIN_EMAILS=

# ---- Participation fees ---------------------------------------------------
# Which business collects artist submission and vendor booth fees. Looked up
# by slug, so it reads as a name rather than an opaque id. Charges are created
# ON this organizer's Stripe Connect account: they are merchant of record and
# the money never touches the platform balance. See docs/participation-fees.md.
ARTNIGHT_ORGANIZER_SLUG=dtla-artnight

# Set by Vercel Cron. The fee sweep accepts this OR ADMIN_API_SECRET.
CRON_SECRET=
