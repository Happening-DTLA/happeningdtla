// DTLAHappening — data model
//
// Domain shape, and why it differs from Eventbrite:
//   Eventbrite models one event = one venue = one ticket.
//   DTLA Art Night is a CRAWL: one night, many venues, people moving between them.
//   So `Night` is a first-class container that groups Events across Venues, and
//   `VenueCheckIn` records a person's route through that night. Retrofitting this
//   later would mean rewriting every ticket query, so it lives here from day one.
//
// Money: ALWAYS integer cents. Never Float/Decimal for currency.
// Ticket integrity: see the invariants documented on Ticket and Scan below.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

/// An attendee. `clerkId` is null for guest checkout — we deliberately let people
/// buy a ticket with just an email/phone and claim the account later. Requiring
/// signup before purchase is the single biggest conversion killer in ticketing.
/**
 * What someone is here to do.
 *
 * Set at onboarding and not a permission system: it decides which submission
 * modules a person is offered, not what they are allowed to read. Everyone can
 * attend, so ATTENDEE is the floor rather than a lesser tier — an artist is an
 * attendee who also shows work.
 */
enum ProfileType {
  ATTENDEE
  ARTIST
  VENUE
}

model User {
  id          String   @id @default(cuid())
  clerkId     String?  @unique
  email       String   @unique
  phone       String?  @unique
  displayName String?
  handle      String?  @unique
  avatarUrl   String?

  /// Which submission modules this person sees. See ProfileType.
  profileType ProfileType @default(ATTENDEE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders         Order[]
  tickets        Ticket[]          @relation("TicketOwner")
  memberships    OrganizerMember[]
  scansPerformed Scan[]            @relation("ScannedBy")
  following      Follow[]          @relation("Follower")
  followers      Follow[]          @relation("Following")
  interests      EventInterest[]
  checkIns       VenueCheckIn[]
  submissions    ArtistSubmission[]

  @@index([email])
}

/// A business that runs venues and events — Logan's friend and his connections.
/// Each one is a Stripe Connect account so ticket revenue lands in THEIR bank,
/// with the platform taking an application fee. We never hold their money.
model Organizer {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  bio          String?
  logoUrl      String?
  contactEmail String
  contactPhone String?

  /// Whether this business is named publicly on its events.
  ///
  /// Some venues want the billing to be attributed and some don't — a landlord
  /// hosting under a promoter's brand, or a business that would rather the
  /// night be the thing people remember. Defaults to shown, because most
  /// organizers want the credit and hiding it should be a deliberate choice.
  publiclyAttributed Boolean @default(true)

  // Stripe Connect
  stripeAccountId String? @unique
  chargesEnabled  Boolean @default(false)
  payoutsEnabled  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members OrganizerMember[]
  invites OrganizerInvite[]
  venues  Venue[]
  events  Event[]
}

enum OrganizerRole {
  OWNER // full access incl. payouts
  MANAGER // create/edit events, see sales
  DOOR_STAFF // can ONLY scan tickets — never sees revenue
}

/// A pending invitation to join a business.
///
/// The only real way to add someone. Held as a row rather than a bare signed
/// link so it can be revoked, listed, and audited — an invite you cannot take
/// back is a permanent hole.
model OrganizerInvite {
  id          String        @id @default(cuid())
  organizerId String
  email       String
  role        OrganizerRole @default(DOOR_STAFF)

  /// Unguessable. Whoever holds it can join, so it is treated as a credential.
  token String @unique

  invitedByUserId  String?
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  organizer Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([organizerId])
  @@index([email])
}

model OrganizerMember {
  id          String        @id @default(cuid())
  organizerId String
  userId      String
  role        OrganizerRole @default(DOOR_STAFF)
  createdAt   DateTime      @default(now())

  organizer Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizerId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Places and nights
// ---------------------------------------------------------------------------

/// A named stretch of Downtown, the way Art Night organises it.
///
/// Deliberately not `Venue.neighborhood`, which is loose descriptive text.
/// A corridor is EDITORIAL: the organisers decide what belongs to it, it
/// carries a colour that appears on the printed map, and it is the unit people
/// actually walk on the night. Free text cannot hold a colour or an order, and
/// two spellings of "Historic Core" would split a corridor in half.
///
/// The colour is stored rather than derived so the app and the poster on the
/// wall always agree, even when the organisers change one.
model Corridor {
  id        String @id @default(cuid())
  name      String
  slug      String @unique
  /// Hex, matching the printed map's key.
  color     String
  /// The street it runs along, for wayfinding copy. Null for a district.
  along     String?
  /// Order on the printed map, north to south.
  sortOrder Int     @default(0)

  /// The street this corridor runs along, as [[lat, lng], ...] runs.
  ///
  /// Real geometry from OpenStreetMap, stored here rather than derived in each
  /// client so the line on the phone and the line on the poster are the same
  /// line. Null for a district, which has no single street to draw.
  path Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venues Venue[]

  @@index([sortOrder])
}

model Venue {
  id          String  @id @default(cuid())
  organizerId String
  corridorId  String?
  name        String
  slug        String  @unique
  description String?
  imageUrl    String?

  address1     String
  address2     String?
  city         String  @default("Los Angeles")
  state        String  @default("CA")
  zip          String
  neighborhood String? // "Arts District", "Historic Core", "Little Tokyo"
  lat          Float?
  lng          Float?

  capacity Int?

  /// The venue's own site. From the organisers' map, where they curate it.
  website String?

  /// How the organisers classify it — "Art Galleries", "Food and Drink",
  /// "Museums", "Shopping". Their words, stored verbatim rather than squeezed
  /// into this app's EventCategory: a museum and a gallery are both "art" to
  /// the enum and are not the same decision to someone choosing where to walk.
  kind String?

  /// Curated flags from the organisers: "21+", "Kid Friendly", "After Party",
  /// "Rooftop Lounge". These are how a visitor actually filters on the night —
  /// can I bring my kid, is there somewhere still open after ten.
  tags String[] @default([])

  /// Photographs of the place, in the organisers' order.
  ///
  /// Stored as source URLs rather than copied files: these come off the
  /// organisers' map, which pulls them from each venue's own business listing,
  /// so the rights to them are the venue's and not ours to re-publish. Holding
  /// a reference means we can stop showing them by deleting a row.
  photos String[] @default([])

  /// Worth naming on the map rather than reducing to a dot — the venues the
  /// printed map draws a building for. A handful per night, deliberately: if
  /// everything is a landmark the map is just labels.
  isLandmark Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizer Organizer      @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  corridor  Corridor?      @relation(fields: [corridorId], references: [id], onDelete: SetNull)
  events    Event[]
  checkIns  VenueCheckIn[]

  @@index([organizerId])
  @@index([neighborhood])
  @@index([corridorId])
}

/// A city-wide night that many venues participate in — the Art Night container.
/// Recurs monthly (first Thursday). A person's ticket wallet and passport are
/// scoped to one of these.
model Night {
  id           String   @id @default(cuid())
  name         String // "Art Night DTLA — October 2026"
  slug         String   @unique // "art-night-2026-10"
  date         DateTime @db.Date
  description  String?
  heroImageUrl String?
  isPublished  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events   Event[]
  checkIns VenueCheckIn[]

  @@index([date])
}

// ---------------------------------------------------------------------------
// Events and ticketing
// ---------------------------------------------------------------------------

/// Browse categories. Kept deliberately short — a long list looks thorough and
/// then every event lands in "Other". Add one only when a real event needs it.
enum EventCategory {
  ART
  MUSIC
  NIGHTLIFE
  FOOD_DRINK
  PERFORMANCE
  MARKET
  WORKSHOP
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model Event {
  id          String  @id @default(cuid())
  organizerId String
  venueId     String
  /// Null for a standalone event; set when it's part of a city-wide Night.
  nightId     String?

  title       String
  slug        String  @unique
  description String?
  imageUrl    String?

  doorsAt  DateTime?
  startsAt DateTime
  endsAt   DateTime?

  status         EventStatus   @default(DRAFT)
  category       EventCategory @default(OTHER)
  minAge         Int? // 21 for bar venues
  isFree         Boolean       @default(false)
  /// Denormalized for cheap list rendering — the lowest active ticket price.
  fromPriceCents Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizer    Organizer       @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  venue        Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  night        Night?          @relation(fields: [nightId], references: [id], onDelete: SetNull)
  ticketTypes  TicketType[]
  orders       Order[]
  tickets      Ticket[]
  interests    EventInterest[]
  doorSessions DoorSession[]

  @@index([nightId])
  @@index([venueId])
  @@index([startsAt])
  @@index([status, startsAt])
  @@index([category, startsAt])
}

/// A purchasable tier. "GA $15", "Early Bird $10", "VIP $40".
///
/// NOTE ON NAMING: `quantitySold` counts inventory that is COMMITTED — both
/// sold tickets and seats currently held by a PENDING order. One counter has
/// half the failure modes of a separate sold/reserved pair, at the cost of a
/// slightly inaccurate name. A hold that expires decrements it again.
///
/// INVARIANT: quantitySold must never exceed quantity. Enforce this in a single
/// transaction at purchase time with a conditional update
/// (`UPDATE ... SET quantitySold = quantitySold + n WHERE id = ? AND quantitySold + n <= quantity`)
/// and treat a 0-row result as sold out. Do NOT read-then-write — two people
/// tapping Buy at the same instant WILL oversell you, and at a door that means
/// turning away someone holding a valid ticket.
model TicketType {
  id          String  @id @default(cuid())
  eventId     String
  name        String
  description String?

  priceCents   Int
  quantity     Int
  quantitySold Int @default(0)
  maxPerOrder  Int @default(8)

  salesStartAt DateTime?
  salesEndAt   DateTime?
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets Ticket[]
  items   OrderItem[]

  @@index([eventId])
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

/// One purchase. Buyer contact is denormalized because guest checkout means
/// there may be no durable User record to join to when we email the tickets.
///
/// Pricing is stored broken out so we can display ALL-IN pricing up front.
/// California requires the total (including fees) to be shown before checkout,
/// and burying fees at the last step is the #1 complaint about Eventbrite anyway.
model Order {
  id      String  @id @default(cuid())
  userId  String?
  eventId String

  status OrderStatus @default(PENDING)

  subtotalCents    Int // sum of ticket face values
  serviceFeeCents  Int @default(0) // visible fee the buyer pays on top
  totalCents       Int // what the card is actually charged
  platformFeeCents Int @default(0) // what DTLAHappening keeps (Stripe application fee)

  buyerName  String?
  buyerEmail String
  buyerPhone String?

  stripePaymentIntentId String? @unique
  stripeChargeId        String?

  /// Bearer secret for this order, handed to the buyer at checkout.
  ///
  /// Guest checkout means there is no login to authorise against, but ticket
  /// codes must not be readable by anyone who can guess an id. A cuid is
  /// unguessable enough to be a primary key and NOT enough to be a
  /// credential, so fetching an order requires this token as well.
  accessToken String @unique @default(cuid())

  /// A PENDING order holds inventory until this moment. Past it, the hold is
  /// released and the seats go back on sale. Without an expiry, abandoned
  /// checkouts would quietly sell out an event that still has room.
  expiresAt DateTime?

  createdAt DateTime  @default(now())
  paidAt    DateTime?
  updatedAt DateTime  @updatedAt

  user    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  event   Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets Ticket[]
  items   OrderItem[]

  @@index([userId])
  @@index([eventId])
  @@index([buyerEmail])
  @@index([status, expiresAt])
}

/// What an order is for, recorded at hold time.
///
/// Exists so that a `Ticket` row can mean exactly one thing: someone paid.
/// The alternative — creating tickets when the hold is placed and flipping
/// them on payment — makes every scan responsible for joining to the order and
/// checking its status, and one forgotten check admits an abandoned checkout.
model OrderItem {
  id           String @id @default(cuid())
  orderId      String
  ticketTypeId String

  quantity       Int
  /// Captured at purchase, so a later price change never rewrites history.
  unitPriceCents Int

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  @@unique([orderId, ticketTypeId])
  @@index([ticketTypeId])
}

enum TicketStatus {
  VALID
  REFUNDED
  VOID
}

/// A single admission.
///
/// INVARIANTS:
///  1. `code` is what the QR encodes. It MUST be unguessable — random, never
///     sequential — or people will mint their own tickets.
///  2. `checkedInAt` is the authoritative admission record and is set exactly
///     once, via a conditional update (`WHERE id = ? AND checkedInAt IS NULL`).
///     A zero-row result means "already used" — that's how a screenshot passed
///     around a group chat gets caught at the door.
///  3. Every scan attempt (success, duplicate, or invalid) is logged to Scan.
///     When someone argues with the door, the log is what settles it.
model Ticket {
  id           String @id @default(cuid())
  orderId      String
  ticketTypeId String
  /// Denormalized so the door scanner resolves a code in ONE indexed lookup.
  eventId      String

  code   String       @unique
  status TicketStatus @default(VALID)

  holderName  String?
  holderEmail String?
  /// Nullable and separate from the order's buyer so tickets can be transferred.
  ownerUserId String?

  unitPriceCents Int

  checkedInAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  owner      User?      @relation("TicketOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  scans      Scan[]

  @@index([orderId])
  @@index([eventId, status])
  @@index([ownerUserId])
}

/// A phone authorised to scan one event's door.
///
/// Door staff are often temporary — a friend working the door for one night.
/// Making each of them create an account, accept an invite and remember a
/// password on a cold sidewalk is friction at exactly the wrong moment, so
/// instead an organizer generates a short pairing code, staff types it once,
/// and that device gets a long token scoped to a single event.
///
/// Two secrets on purpose: the SHORT code is readable aloud and dies on first
/// use, the LONG token is what every scan presents and never gets spoken.
model DoorSession {
  id      String @id @default(cuid())
  eventId String

  /// Short, human-readable, single-use. Consumed when a device pairs.
  pairingCode          String    @unique
  pairingCodeExpiresAt DateTime
  claimedAt            DateTime?

  /// Issued at pairing. Null until then, so an unclaimed session grants nothing.
  token       String? @unique
  deviceLabel String?

  /// Pairing and scanning only work inside this window. Defaults to a short
  /// while before doors until the event ends, so a code leaked in advance is
  /// inert, and a paired phone stops working once the night is over.
  activeFrom DateTime

  /// Doors are a one-night affair; a token that outlives the event is a
  /// liability with no upside.
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scans Scan[]

  @@index([eventId])
}

enum ScanResult {
  ADMITTED
  DUPLICATE // already checked in — show when and where
  INVALID_CODE
  WRONG_EVENT
  REFUNDED_TICKET
  NOT_YET_VALID
}

/// Append-only audit log of every scan attempt at every door.
model Scan {
  id       String  @id @default(cuid())
  ticketId String?
  /// Raw scanned string, kept even when it matches no ticket, so we can debug
  /// "the scanner didn't work" reports after the fact.
  rawCode  String

  result            ScanResult
  scannedByUserId   String?
  venueId           String?
  deviceId          String? // which door/phone, for reconciling gate counts
  scannedAt         DateTime   @default(now())
  /// True when the scan was captured offline and synced later.
  syncedFromOffline Boolean    @default(false)

  ticket        Ticket?      @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  scannedBy     User?        @relation("ScannedBy", fields: [scannedByUserId], references: [id], onDelete: SetNull)
  doorSession   DoorSession? @relation(fields: [doorSessionId], references: [id])
  doorSessionId String?

  @@index([ticketId])
  @@index([scannedAt])
}

/// Stripe delivers webhooks AT LEAST once, and will retry on any non-2xx.
/// Without this dedupe table a retry issues a second set of tickets for one
/// payment. Insert the event id here inside the same transaction that fulfills
/// the order; a unique violation means "already handled, ack and move on."
model WebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())
  payload       Json?
}

// ---------------------------------------------------------------------------
// Social / the crawl
// ---------------------------------------------------------------------------

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

enum InterestLevel {
  INTERESTED
  GOING
}

/// Lightweight RSVP — lets someone signal intent for a free or sold-out event
/// without a transaction, and gives us demand data before tickets go on sale.
model EventInterest {
  id        String        @id @default(cuid())
  userId    String
  eventId   String
  level     InterestLevel @default(INTERESTED)
  createdAt DateTime      @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
}

/// The passport. One row each time someone arrives at a venue during a Night —
/// this is the raw material for the route map, "3 of 8 stops", and seeing where
/// friends are. Distinct from Scan: a check-in is social and can happen at a
/// free venue with no ticket at all.
/**
 * Somebody stood at a door.
 *
 * The phone is the source of truth for this, not the database — a passport
 * that needs the network to stamp fails in the ground-floor gallery it exists
 * for. These rows are the aggregate copy, sent when there is signal, and they
 * exist to answer one question for the organisers: how many people actually
 * walked to each venue.
 *
 * So it identifies a device rather than a person. `deviceId` is a random value
 * generated on install, tied to no account and no contact detail, and a
 * reinstall produces a new one — deliberately, because a counter does not need
 * an identifier that survives reinstalls, and one that did would be a tracking
 * id. `userId` is there for later, when someone signed in wants their stamps
 * on a second phone.
 */
model VenueCheckIn {
  id      String  @id @default(cuid())
  userId  String?
  /// Anonymous, per-install. See the note above.
  deviceId String?
  venueId String
  nightId String?

  /// When the person stamped it, which is not when we heard about it — a
  /// stamp collected in a basement may arrive an hour later.
  at DateTime @default(now())
  /// Whether the phone could see them near the door at the time. False is a
  /// legitimate check-in, not a suspect one: GPS in the Historic Core is poor
  /// and refusing someone standing in the room is the worse failure.
  verified Boolean @default(false)

  createdAt DateTime @default(now())

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  venue Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  night Night? @relation(fields: [nightId], references: [id], onDelete: SetNull)

  @@unique([deviceId, venueId, nightId])
  @@index([nightId])
  @@index([venueId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Abuse control
// ---------------------------------------------------------------------------

/// Fixed-window request counters. See `src/lib/rate-limit.ts`.
///
/// In Postgres rather than memory on purpose. An in-process counter protects
/// nothing the moment the app runs as more than one instance — every serverless
/// invocation would start its own count — and this is the table that stops one
/// script holding every seat of an event.
///
/// INVARIANT: the window start is part of the KEY, never a column. A new window
/// is therefore a new row, so a counter from a previous window can never be
/// incremented by mistake, and the increment stays a single atomic upsert with
/// no read-then-write.
model RateLimit {
  /// "<bucket>:<subject>:<window start, epoch seconds>"
  key   String @id
  count Int    @default(1)

  /// Rows past this are dead weight and safe to delete in bulk.
  expiresAt DateTime

  @@index([expiresAt])
}


/**
 * Where an artist's application has got to.
 *
 * Mirrors the process the organisers already publish rather than a generic
 * workflow: work is reviewed, and a decline is explicitly not the end — their
 * page promises five days to resubmit new work at no additional charge, which
 * is why DECLINED carries a deadline rather than closing the record.
 *
 * APPROVED means the curatorial decision is made, not that the artist is in.
 * Participation is confirmed when the placement invoice is paid, and that is a
 * separate fact from whether the work was accepted.
 */
enum SubmissionStatus {
  SUBMITTED
  IN_REVIEW
  APPROVED
  DECLINED
  WITHDRAWN
}

/**
 * An artist applying to exhibit in the ArtNight gallery network.
 *
 * Modelled on the organisers' own form at dtlaartnight.com/artist-submission,
 * field for field, so an application made here is one their curatorial process
 * already knows how to read. The one deliberate departure is the artwork list:
 * their form collects it as a folder of files named
 * "ArtistLastName_Title_Size_Price.jpg" and warns that unclear labelling
 * delays review. Since the placement invoice is calculated per piece, those
 * are real columns here instead of a filename convention.
 */
model ArtistSubmission {
  id     String  @id @default(cuid())
  /// Linked when we know who this is. Null for a submission made before the
  /// artist has an account — the same guest-first path checkout uses.
  userId String?

  firstName String
  lastName  String
  email     String
  phone     String

  address1 String
  address2 String?
  city     String
  state    String
  zip      String

  /// Their form requires these and accepts the literal "NA", so this stores
  /// what the artist actually typed rather than pretending it is a URL.
  socials String
  website String

  /// "Paintings", "Drawings", "Sculpture", "Mixed Media", "Print Making",
  /// "Other" — their labels, multi-select, stored verbatim.
  media String[] @default([])

  /// Body of work, for review context. Their form allows up to ten files.
  portfolioImages String[] @default([])

  status SubmissionStatus @default(SUBMITTED)

  /// Consent to email and SMS updates, with the moment it was given. A boolean
  /// alone cannot answer "when did they agree", which is the only question
  /// that matters if it is ever disputed.
  consentAt DateTime

  reviewedAt   DateTime?
  reviewerNote String?
  /// Set on a decline: their published promise is five days to resubmit new
  /// work at no additional charge, so the deadline is data, not a policy page.
  resubmitBy DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  artworks SubmissionArtwork[]

  @@index([email])
  @@index([status, createdAt])
  @@index([userId])
}

/**
 * One piece being submitted for placement.
 *
 * Priced individually because the organisers invoice per accepted piece, and
 * measured because placement depends on it — their published rule quotes
 * separately for anything over four feet tall, three feet wide or fifty
 * pounds, so the dimensions decide which pieces need a custom quote.
 *
 * Dimensions are inches INCLUDING THE FRAME, which is what their form asks for
 * and what a wall actually has to accommodate.
 */
model SubmissionArtwork {
  id           String @id @default(cuid())
  submissionId String

  title  String
  medium String?

  heightIn Float?
  widthIn  Float?
  depthIn  Float?
  weightLb Float?

  /// Asking price, in cents. Artists keep 100% of sales; this is what the
  /// piece is listed at, not a figure anyone takes a cut of.
  priceCents Int

  imageUrl String

  position Int @default(0)

  submission ArtistSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}
