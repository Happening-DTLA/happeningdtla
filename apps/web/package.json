    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "setup": "npm run db:start && npm run db:migrate && npm run db:seed",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test:inventory": "tsx scripts/test-inventory.ts",
    "test:checkout": "tsx scripts/test-checkout-e2e.ts",
    "test:door": "tsx scripts/test-door.ts",
    "test:team": "tsx scripts/test-team.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.8.0",
    "@dtlahappening/core": "*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@stripe/stripe-js": "^9.14.0",
    "@types/pg": "^8.23.1",
    "@zxing/browser": "^0.2.1",
    "date-fns": "^4.4.0",
    "nanoid": "^6.0.1",
    "next": "16.3.2",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.22.0",
    "stripe": "^22.5.0",
    "zod": "^4.4.3"
