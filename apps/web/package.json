{
  "name": "@dtlahappening/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:start": "node scripts/dev-db.mjs",
    "db:stop": "prisma dev stop dtlahappening",
    "db:migrate": "prisma migrate dev",
