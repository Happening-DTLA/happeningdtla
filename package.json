{
  "name": "dtlahappening",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web": "npm run dev --workspace apps/web",
    "mobile": "npm run start --workspace apps/mobile",
    "db:start": "npm run db:start --workspace apps/web",
    "db:stop": "npm run db:stop --workspace apps/web",
    "db:migrate": "npm run db:migrate --workspace apps/web",
    "db:seed": "npm run db:seed --workspace apps/web",
    "db:studio": "npm run db:studio --workspace apps/web",
    "db:reset": "npm run db:reset --workspace apps/web",
    "setup": "npm run setup --workspace apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  }
}
